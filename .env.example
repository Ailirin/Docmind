APP_NAME=DocMind
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
API_KEY=change-me
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=20971520

DATABASE_URL=postgresql+psycopg2://docmind:docmind@localhost:5432/docmind

EXTRACTOR_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama3.2:1b
