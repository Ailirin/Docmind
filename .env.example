APP_NAME=DocMind
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
API_KEY=change-me
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=20971520

DATABASE_URL=postgresql+asyncpg://docmind:docmind@localhost:5432/docmind

# mock — быстро, без модели (по умолчанию)
# llm  — через OpenAI-совместимый API (требует запущенного Ollama или внешнего провайдера)
EXTRACTOR_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama3.2:1b
LLM_BASE_URL=http://127.0.0.1:11434/v1

RABBITMQ_URL=amqp://docmind:docmind@localhost:5672/
RABBITMQ_QUEUE=documents.process
RABBITMQ_DLQ=documents.process.dlq

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

METRICS_USERNAME=metrics
METRICS_PASSWORD=change-me

# --- Docker Compose (docker-compose.yml) ---
# Пароли для контейнеров. ADMIN_PASSWORD / METRICS_PASSWORD / API_KEY выше — тоже обязательны.
# ВНИМАНИЕ: POSTGRES_PASSWORD, RABBITMQ_PASSWORD, GRAFANA_ADMIN_PASSWORD применяются только
# при первой инициализации тома; для уже созданных томов смените пароль внутри сервиса
# (или пересоздайте том: docker compose down -v). Не используйте в паролях символы @ : / ?
# (они ломают URL подключения).
POSTGRES_PASSWORD=docmind
RABBITMQ_PASSWORD=docmind
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
